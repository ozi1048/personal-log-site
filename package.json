{
  "name": "personal-log-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "wrangler dev",
    "test": "node scripts/test-build.mjs",
    "test:preview": "node scripts/test-preview.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "migrate:wordpress": "node scripts/migrate-wordpress.mjs",
    "migrate:wordpress:snapshot": "node scripts/migrate-wordpress.mjs --from-snapshot",
    "wrangler": "WRANGLER_LOG_PATH=.wrangler/logs wrangler",
    "deploy": "pnpm build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/turndown": "^5.0.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  }
}
