# Previewでは実際のGA4 IDを設定しないでください。
PUBLIC_GA_MEASUREMENT_ID=

# build時のcanonical・sitemap・RSSのoriginです。
PUBLIC_SITE_URL=https://personal-log-site-preview.cloudflare-migration-plan.workers.dev

# preview または production。previewでは常にnoindexになります。
PUBLIC_DEPLOYMENT_ENV=preview

# productionでも明示的にtrueを設定した場合だけFormspree送信を有効化します。
PUBLIC_CONTACT_FORM_ENABLED=false

# Turnstileの公開Site Key。previewでは値があってもwidgetを出力しません。Secret Keyはここへ置かず、commitしないでください。
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEZOOB4bmw0qotmj
