---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { canonicalFor, isPreview } from '../lib/seo';
import { resolveImageUrl } from '../lib/images';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  schema?: object | object[];
  robots?: string;
}

const {
  title,
  description = SITE.description,
  image,
  canonical: sourceCanonical,
  type = 'website',
  schema = [],
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — 過去と向き合うための記録`;
const canonical = canonicalFor(Astro.url.pathname, sourceCanonical);
const ogImage = resolveImageUrl(image, new URL(canonical).origin);
const schemas = Array.isArray(schema) ? schema : [schema];
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const robotsContent = isPreview ? 'noindex, nofollow, noarchive, nosnippet' : robots;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f5f1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.filter(Boolean).map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
    ))}

    {gaMeasurementId && !isPreview && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
