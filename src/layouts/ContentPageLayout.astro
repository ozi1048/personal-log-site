---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
---

<BaseLayout title={page.data.title} description={page.data.description} canonical={page.data.canonical}>
  <article class="content-page shell-reading">
    <header>
      <p class="eyebrow">{page.data.eyebrow}</p>
      <h1>{page.data.title}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
