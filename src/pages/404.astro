---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" description="お探しの記録は見つかりませんでした。" robots="noindex, follow">
  <section class="not-found">
    <div>
      <strong>404</strong>
      <p class="eyebrow">LOG NOT FOUND</p>
      <h1>その記録は見つかりませんでした。</h1>
      <p>URLを確認するか、記録一覧から続きを探してください。</p>
      <p><a class="text-link" href="/articles/">記録一覧へ戻る →</a></p>
    </div>
  </section>
</BaseLayout>
