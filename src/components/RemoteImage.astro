---
import { resolveDisplayImageUrl } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  width?: number;
  height?: number;
}

const { src, alt, class: className, loading = 'lazy', width, height } = Astro.props;
---

<img
  src={resolveDisplayImageUrl(src)}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  referrerpolicy="no-referrer"
  width={width}
  height={height}
/>
