---
import { resolveDisplayImageUrl } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className, loading = 'lazy' } = Astro.props;
---

<img
  src={resolveDisplayImageUrl(src)}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  referrerpolicy="no-referrer"
/>
