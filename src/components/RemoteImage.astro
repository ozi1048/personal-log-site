---
import { resolveImageUrl } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className, loading = 'lazy' } = Astro.props;
---

<img
  src={resolveImageUrl(src)}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
  referrerpolicy="no-referrer"
/>
