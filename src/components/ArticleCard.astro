---
import type { Post } from '../lib/content';
import { formatDate, postPath } from '../lib/content';
import CategoryPills from './CategoryPills.astro';
import RemoteImage from './RemoteImage.astro';

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['article-card', { featured }]}>
  <a class="article-card-image" href={postPath(post)} tabindex="-1" aria-hidden="true">
    <RemoteImage src={post.data.featuredImage} alt="" />
    <span class="log-stamp">#{String(post.data.logNumber).padStart(2, '0')}</span>
  </a>
  <div class="article-card-body">
    <div class="card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <CategoryPills categories={post.data.categories} />
    </div>
    <h2><a href={postPath(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <a class="text-link" href={postPath(post)}>この記録を読む <span aria-hidden="true">→</span></a>
  </div>
</article>
