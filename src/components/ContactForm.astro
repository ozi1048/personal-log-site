---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim();
const deploymentEnvironment = import.meta.env.PUBLIC_DEPLOYMENT_ENV;
const isSendCapableEnvironment = deploymentEnvironment === 'production' || deploymentEnvironment === 'production-candidate';
const contactFormEnabled = isSendCapableEnvironment
  && import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true'
  && Boolean(turnstileSiteKey);
const formEndpoint = contactFormEnabled ? 'https://formspree.io/f/xeajwayl' : undefined;
const turnstileEnabled = contactFormEnabled;
---

<section class="contact-form-section" aria-labelledby="contact-form-heading">
  <div class="contact-form-heading">
    <p class="eyebrow">MESSAGE</p>
    <h2 id="contact-form-heading">メッセージを送る</h2>
    <p>返信が必要な場合は、受信可能なメールアドレスをご入力ください。</p>
  </div>

  {!contactFormEnabled && (
    <p class="contact-preview-notice" role="note">
      {!isSendCapableEnvironment
        ? 'Preview環境では誤送信防止のため、フォーム送信を停止しています。'
        : 'お問い合わせフォームはTurnstile設定完了後に有効になります。'}
    </p>
  )}

  <form
    id="contact-form"
    class="contact-form"
    action={formEndpoint}
    method="POST"
    novalidate
    aria-describedby="contact-form-note contact-form-status"
    data-enabled={String(contactFormEnabled)}
  >
    <div class="contact-field">
      <label for="contact-name">お名前 <span>任意</span></label>
      <input id="contact-name" name="name" type="text" autocomplete="name" disabled={!contactFormEnabled} />
      <p id="contact-name-error" class="contact-field-error" aria-live="polite"></p>
    </div>

    <div class="contact-field">
      <label for="contact-email">メールアドレス <span aria-hidden="true">必須</span></label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        aria-required="true"
        aria-describedby="contact-email-error"
        disabled={!contactFormEnabled}
      />
      <p id="contact-email-error" class="contact-field-error" aria-live="polite"></p>
    </div>

    <div class="contact-field">
      <label for="contact-message">お問い合わせ内容 <span aria-hidden="true">必須</span></label>
      <textarea
        id="contact-message"
        name="message"
        rows="8"
        required
        aria-required="true"
        aria-describedby="contact-message-error"
        disabled={!contactFormEnabled}
      ></textarea>
      <p id="contact-message-error" class="contact-field-error" aria-live="polite"></p>
    </div>

    <input type="text" name="_gotcha" class="contact-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" disabled={!contactFormEnabled} />
    <input type="hidden" name="_subject" value="calmapercorso お問い合わせ" disabled={!contactFormEnabled} />

    {turnstileEnabled && (
      <div class="contact-turnstile" aria-describedby="contact-turnstile-error">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
        <p id="contact-turnstile-error" class="contact-field-error" aria-live="polite"></p>
      </div>
    )}

    <p id="contact-form-note" class="contact-form-note">
      送信された情報は、お問い合わせへの対応にのみ使用します。
    </p>
    <button class="contact-submit" type="submit" disabled={!contactFormEnabled}>
      <span class="contact-submit-label">送信する</span>
      <span class="contact-submit-progress" hidden>送信中…</span>
    </button>
    <p id="contact-form-status" class="contact-form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></p>
  </form>
</section>

{turnstileEnabled && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script is:inline define:vars={{ formEndpoint, turnstileEnabled }}>
  const contactForm = document.querySelector('#contact-form');

  if (contactForm instanceof HTMLFormElement) {
    const submitButton = contactForm.querySelector('button[type="submit"]');
    const submitLabel = contactForm.querySelector('.contact-submit-label');
    const submitProgress = contactForm.querySelector('.contact-submit-progress');
    const status = contactForm.querySelector('#contact-form-status');
    const turnstileError = contactForm.querySelector('#contact-turnstile-error');
    const fields = {
      email: contactForm.querySelector('#contact-email'),
      message: contactForm.querySelector('#contact-message'),
    };

    const setFieldError = (name, message) => {
      const field = fields[name];
      const error = contactForm.querySelector(`#contact-${name}-error`);
      if (!(field instanceof HTMLElement) || !(error instanceof HTMLElement)) return;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      error.textContent = message;
    };

    const clearErrors = () => {
      setFieldError('email', '');
      setFieldError('message', '');
      if (turnstileError instanceof HTMLElement) turnstileError.textContent = '';
      if (status instanceof HTMLElement) {
        status.textContent = '';
        status.removeAttribute('data-state');
      }
    };

    const validate = () => {
      let firstInvalidField;
      const email = fields.email;
      const message = fields.message;

      if (email instanceof HTMLInputElement) {
        if (!email.value.trim()) {
          setFieldError('email', 'メールアドレスを入力してください。');
          firstInvalidField ||= email;
        } else if (!email.validity.valid) {
          setFieldError('email', 'メールアドレスの形式を確認してください。');
          firstInvalidField ||= email;
        }
      }

      if (message instanceof HTMLTextAreaElement && !message.value.trim()) {
        setFieldError('message', 'お問い合わせ内容を入力してください。');
        firstInvalidField ||= message;
      }

      firstInvalidField?.focus();
      return !firstInvalidField;
    };

    const setSubmitting = (submitting) => {
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = submitting;
      if (submitLabel instanceof HTMLElement) submitLabel.hidden = submitting;
      if (submitProgress instanceof HTMLElement) submitProgress.hidden = !submitting;
      contactForm.setAttribute('aria-busy', String(submitting));
    };

    Object.entries(fields).forEach(([name, field]) => {
      field?.addEventListener('input', () => setFieldError(name, ''));
    });

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      if (!formEndpoint) {
        if (status instanceof HTMLElement) {
          status.dataset.state = 'error';
          status.textContent = 'Preview環境では送信できません。';
        }
        return;
      }

      if (!validate()) {
        if (status instanceof HTMLElement) {
          status.dataset.state = 'error';
          status.textContent = '入力内容をご確認ください。';
        }
        return;
      }

      const formData = new FormData(contactForm);
      if (turnstileEnabled && !formData.get('cf-turnstile-response')) {
        if (turnstileError instanceof HTMLElement) {
          turnstileError.textContent = '「私はロボットではありません」の確認を完了してください。';
        }
        if (status instanceof HTMLElement) {
          status.dataset.state = 'error';
          status.textContent = 'Turnstileの確認が必要です。';
        }
        return;
      }

      setSubmitting(true);
      if (status instanceof HTMLElement) status.textContent = '送信しています。';

      try {
        const response = await fetch(formEndpoint, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          const result = await response.json().catch(() => null);
          if (Array.isArray(result?.errors)) {
            result.errors.forEach((error) => {
              if (error?.field === 'email' || error?.field === 'message') {
                setFieldError(error.field, error.message || '入力内容をご確認ください。');
              }
            });
          }
          throw new Error('Formspree rejected the submission');
        }

        contactForm.reset();
        window.turnstile?.reset();
        if (status instanceof HTMLElement) {
          status.dataset.state = 'success';
          status.textContent = 'お問い合わせを送信しました。ありがとうございました。';
          status.focus({ preventScroll: true });
        }
      } catch {
        window.turnstile?.reset();
        if (status instanceof HTMLElement) {
          status.dataset.state = 'error';
          status.textContent = '送信できませんでした。時間をおいて、もう一度お試しください。';
        }
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
